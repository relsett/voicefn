#!/bin/bash -e
# Ships the website from HEAD to the host: sources → build there → restart behind Caddy.
# Optional: SUPPORT_EMAIL=… in /opt/voicefn-cloud/.env on the host.
HOST=${DEPLOY_HOST:-apps-kz}   # an ssh alias
DIR=/opt/voicefn-cloud
DOMAIN=${DOMAIN:-voicefn.driftstatic.com}
PORT=8090
SSH=(ssh -i "${SSH_KEY:-$HOME/.ssh/id_rsa}" "$HOST")
cd "$(dirname "$0")/../.."

git diff --quiet HEAD -- server || { echo "server/ has uncommitted changes"; exit 1; }
git archive --format=tar HEAD:server | "${SSH[@]}" "sudo rm -rf $DIR/src && sudo mkdir -p $DIR/src && sudo tar -x -C $DIR/src \
  && sudo cp $DIR/src/deploy/compose.yml $DIR/"
"${SSH[@]}" "printf '%s {\n\treverse_proxy 127.0.0.1:%s\n}\n' $DOMAIN $PORT \
    | sudo tee /etc/caddy/sites/voicefn-cloud.caddy >/dev/null \
  && sudo caddy validate --adapter caddyfile --config /etc/caddy/Caddyfile >/dev/null && sudo systemctl reload caddy \
  && cd $DIR && sudo docker compose up -d --build && sudo docker image prune -f >/dev/null"
for i in $(seq 1 30); do
  "${SSH[@]}" "curl -fsS -o /dev/null http://127.0.0.1:$PORT/healthz" 2>/dev/null && { echo "OK $(git rev-parse --short HEAD) https://$DOMAIN/"; exit 0; }
  sleep 2
done
echo "The server didn't start"; "${SSH[@]}" "cd $DIR && sudo docker compose logs --tail 50"; exit 1
